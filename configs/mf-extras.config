# ============================================================================
# Nokia XG-040G-MF 增量编译配置
# 用法：cp configs/an7583.config .config && cat mf-extras.config >> .config
#       && make defconfig
# 说明：这里只写"在 ponwrt 的 an7583 基线之上额外要加的东西"。
#       树里不存在的符号会被 defconfig 静默丢弃，不会导致编译失败。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、PON / ONU 栈（必需，少了光口就用不了）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-app-iptv=y

# 中文界面（pon + iptv）
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------------------------------------------------------------------------
# 二、MF 硬件相关：NPU 固件必须用 an7583 的，不要用 7581 的
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_airoha-an7583-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y

# ---------------------------------------------------------------------------
# 三、常用工具（轻量，双核 512M 完全扛得住）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-argon=y

# USB / 存储（MF 有两个 USB 口，但 OpenWrt 下 AN7583 的 USB 目前不可用，
# 先留着驱动，等上游修好后直接可用）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y

# ---------------------------------------------------------------------------
# 四、全局广告过滤（用户指定）
# 依赖链：curl / resolveip / ucode-mod-* 自动带入；
# 基线 configs/an7583.config 已启用 dnsmasq-full 且带 nftset，
# adblock-fast 会走 nftset 模式（性能最好，无需重启 dnsmasq）。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y

# ---------------------------------------------------------------------------
# 五、可选项（默认关闭，需要就改成 =y）
# 512 MiB 内存 + 2 核 1.2 GHz，全开会很卡，建议最多开一个
# ---------------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-app-ksmbd=y
# CONFIG_PACKAGE_luci-app-vlmcsd=y
# CONFIG_PACKAGE_rtp2httpd=y
# CONFIG_PACKAGE_luci-app-rtp2httpd=y
# CONFIG_PACKAGE_luci-app-usb-printer=y
